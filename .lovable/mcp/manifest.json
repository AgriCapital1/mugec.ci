{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "mugec-ci-mcp",
      "version": "0.1.0",
      "title": "MUGEC-CI"
    },
    "tools": [
      {
        "name": "list_news",
        "title": "Lister les actualités MUGEC-CI",
        "description": "Retourne les actualités publiées (titre, résumé, date, URL).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "description": "Nombre maximum d'articles à retourner."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_opportunities",
        "title": "Lister les opportunités MUGEC-CI",
        "description": "Retourne les opportunités publiées (emploi, formation, marché) avec date limite.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "description": "Nombre maximum d'opportunités à retourner."
            },
            "type": {
              "type": "string",
              "description": "Filtre optionnel sur le type (Emploi, Formation, Marché public...)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
